# Copy to .env and fill in. .env is gitignored and injected at runtime —
# nothing here is baked into the image.

WIRESPLOIT_ES_URL=http://100.95.111.97:9200
WIRESPLOIT_ES_INDEX=wiresploit-poc1

# Preferred: an API key
WIRESPLOIT_ES_API_KEY=

# ...or basic auth instead (leave API key blank if you use these)
# WIRESPLOIT_ES_USER=
# WIRESPLOIT_ES_PASSWORD=

# Plain HTTP over Tailscale -> no TLS cert to verify
WIRESPLOIT_ES_VERIFY_CERTS=0
